<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="crm_lead_view_form_mail_sync" model="ir.ui.view">
        <field name="name">crm.lead.form.mail.sync</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_mail_sync_messages" type="object" class="oe_stat_button" icon="fa-envelope-o" groups="mail_sync_microsoft.group_mail_sync_user">
                    <field name="mail_sync_count" widget="statinfo" string="E-Mails"/>
                </button>
                <button name="action_view_mail_sync_suggestions" type="object" class="oe_stat_button" icon="fa-lightbulb-o" invisible="mail_sync_suggestion_count == 0" groups="mail_sync_microsoft.group_mail_sync_user">
                    <field name="mail_sync_suggestion_count" widget="statinfo" string="Vorschläge"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
