<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="mail_sync_account_view_form_crm" model="ir.ui.view">
        <field name="name">mail.sync.account.form.crm</field>
        <field name="model">mail.sync.account</field>
        <field name="inherit_id" ref="mail_sync_microsoft.mail_sync_account_view_form"/>
        <field name="arch" type="xml">
            <page name="domains" position="after">
                <page string="Verkaufschancen" name="crm">
                    <group>
                        <group string="Zuordnung">
                            <field name="deal_reference_regex"/>
                            <field name="retro_days"/>
                        </group>
                        <group string="Scoring bei mehreren offenen Verkaufschancen">
                            <field name="score_owner"/>
                            <field name="score_subject"/>
                            <field name="score_activity"/>
                            <field name="score_recent"/>
                            <field name="score_threshold"/>
                        </group>
                    </group>
                </page>
            </page>
        </field>
    </record>
</odoo>
